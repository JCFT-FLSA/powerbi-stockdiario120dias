	column VtaCruzada
		dataType: string
		lineageTag: 85f48f2d-cb12-41f2-bb04-5026ed723d2a
		summarizeBy: none
		sourceColumn: VtaCruzada

		annotation SummarizationSetBy = Automatic

	column PVC = ```
			// Procedimiento de Venta Cruzada ("Ok" | "No PVC")
			IF (
			    Ventas[VtaCruzada] = "Normal",
			    "Ok",
			    VAR FechaVta = Ventas[Fecha]
			    VAR Meses =
			        DATEDIFF ( FechaVta, TODAY(), MONTH )
			    VAR _IsMaterialSucursal = Ventas[Id_MaterialSucursal] 
			
			    -- opcional pero recomendable: acotar el rango antes de consultar tablas grandes
			    VAR StockCentro =
			        SWITCH (
			            Meses,
			            0, CALCULATE ( VALUES ( Stock_Materiales[Stock] ), Stock_Materiales[Fecha] = FechaVta && Stock_Materiales[Id_MaterialCentro] = _IsMaterialSucursal),
			            1, CALCULATE ( VALUES ( Stock_Materiales[Stock] ), Stock_Materiales[Fecha] = FechaVta && Stock_Materiales[Id_MaterialCentro] = _IsMaterialSucursal),
			            2, CALCULATE ( VALUES ( Stock_Materiales[Stock] ), Stock_Materiales[Fecha] = FechaVta && Stock_Materiales[Id_MaterialCentro] = _IsMaterialSucursal),
			            3, CALCULATE ( VALUES ( Stock_Materiales[Stock] ), Stock_Materiales[Fecha] = FechaVta && Stock_Materiales[Id_MaterialCentro] = _IsMaterialSucursal),
			            BLANK()
			        )
			    RETURN
			        IF (
			            Meses IN { 0, 1, 2, 3 } &&
			            NOT ISBLANK ( StockCentro ) &&
			            StockCentro >= Ventas[Qty],
			            "No PVC",
			            "Ok"
			        )
			)
			
			```
		dataType: string
