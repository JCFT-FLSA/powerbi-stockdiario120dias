				    #"Se expandió Sucursales" = Table.ExpandTableColumn(#"Consultas combinadas", "Sucursales", {"CodSuc", "Centro Supply"}, {"CodSuc", "Centro Supply"}),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Se expandió Sucursales",{{"CodSuc", Int64.Type}}),
				    #"Personalizada agregada1" = Table.AddColumn(#"Tipo cambiado", "CentroVtaCruzada", each if [Centro] = "0190" or [Centro] = "EL ALTO" or [Centro] = "QUILLACOLLO" then [Centro Supply] else [Centro]),
				    #"Agregar columna personalizada" = Table.AddColumn(#"Personalizada agregada1", "Id_MaterialSucursal", each Text.Combine({Text.PadEnd(Date.ToText([Fecha], "yyyy"), 5, "-"), Text.Reverse(Text.Middle(Text.Reverse(Text.From([Material], "es-BO")), 7)), Text.End(Text.From([Material], "es-BO"), 8), Text.PadStart(Text.From([CodSuc], "es-BO"), 4, "-")}), type text),
				    #"Personalizada agregada" = Table.AddColumn(#"Agregar columna personalizada", "VtaCruzada", each if [CentroVtaCruzada] = [Centro Supply] then "Normal" else "VentaCruzada"),
				    #"Otras columnas quitadas" = Table.SelectColumns(#"Personalizada agregada",{"Canal distribución", "Clase de factura", "Fecha", "Factura", "Material", "Sucursal", "Promoción", "Vendedor", "Sector", "Cliente", "Centro", "División", "Costo", "Qty", "Facturado", "Descuento", "DescuentoBruto", "Precio", "Venta", "Nit", "CodSuc", "Id_MaterialSucursal", "VtaCruzada"})
				in
				    #"Otras columnas quitadas"
